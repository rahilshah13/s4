# --- Build Stage ---
FROM alpine:3.19 AS builder
RUN apk add --no-cache \
    build-base \
    sqlite-dev \
    musl-dev

WORKDIR /app
COPY . .
RUN gcc -O3 -D_FILE_OFFSET_BITS=64 -std=c99 \
    s4_gateway.c s4_storage.c s4_auth.c \
    -o s4_server -lsqlite3

# --- Runtime Stage ---
FROM alpine:3.19
RUN apk add --no-cache \
    sqlite-libs \
    ca-certificates

WORKDIR /app
# Copy the compiled binary from the builder stage
COPY --from=builder /app/s4_server /app/s4_server
RUN mkdir -p /data/s4/objects
ENV S4_PORT=8080
ENV S4_DB_PATH=/data/s4/s4_metadata.db
ENV S4_STORAGE_PATH=/data/s4/objects
EXPOSE 8080
CMD ["./s4_server"]
